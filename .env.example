# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-this
PORT=5000

# API Authentication (comma-separated for multiple keys)
API_KEYS=your-secure-api-key,second-key-optional

# Optional: Database Connection (for presets)
DEFAULT_DB_TYPE=mysql
DEFAULT_HOST=localhost
DEFAULT_PORT=3306
DEFAULT_USER=root
DEFAULT_PASSWORD=
DEFAULT_DATABASE=

# Logging
LOG_LEVEL=INFO
LOG_FILE=sqldumper.log

# Security
MAX_UPLOAD_SIZE=50M
RATE_LIMIT=200/day
RATE_LIMIT_HOUR=50/hour

# Nginx/Proxy
DOMAIN_NAME=localhost
SSL_ENABLED=false
